# Never paste secrets into chats or commit this file with a real key.
# Set values locally in .env (git-ignored). Use a key with TRADE + READ permission ONLY
# (NO withdrawal permission) and, if possible, an IP allow-list.
# Read README_FA.md first; the live procedure is docs/RUNBOOK_LIVE_FA.md (VPS: docs/VPS_SYSTEMD_FA.md).
WALLEX_API_KEY=
# paper | backtest | live   (default paper)
TRADING_MODE=paper
# conservative (default) | competition  - see README_FA.md before changing
PROFILE=conservative
INITIAL_TMN=5000000
COMPETITION_HOURS=24
# (profile sets this; uncomment ONLY to override the profile) MAX_EXPOSURE_FRACTION=0.25
# What to do with holdings when the competition clock ends:
# report_only (default; never sells automatically) | flatten_to_usdt | flatten_to_tmn
FINAL_POLICY=report_only
# Live needs ALL of: ENABLE_LIVE=true, an explicit DATA_DIR, the CLI flag
# --i-understand-real-money, a passing `selftest` (the full test suite) + `check-live`
# attestation for THIS source tree, a passing `canary` (one tiny real order, placed and
# cancelled: `wallex-agent canary --i-understand-real-money`), no KILL file, and the phrase
# typed at a terminal. The FIRST live start is always interactive; `live --resume` only
# continues a started competition (docs/RUNBOOK_LIVE_FA.md).
ENABLE_LIVE=false
# Where state, evidence files and KILL live. Relative paths are resolved against the directory
# you run the command FROM; use an ABSOLUTE path for live (and the same one for `kill`).
DATA_DIR=state
# Paper/backtest only: ASSUMED per-side fee rate (live always uses your account's real fee).
PAPER_FEE_RATE=0.0035
# ---- Network route to api.wallex.ir (README_FA.md section 11). Check it BEFORE trading with
# `wallex-agent net-check` (GET only; prints every step: proxy CONNECT, TLS, HTTP, bytes, timings).
# By default the bot connects DIRECTLY and ignores every proxy (also the Windows/OS proxy settings).
# Explicit HTTP CONNECT proxy (wins over the environment), e.g. a local proxy app:
#   WALLEX_PROXY_URL=http://127.0.0.1:2080
# Only http://host:port (the port is required); http://user:pass@host:port if the proxy needs a login
# (the credentials are never printed). https:// and socks proxies are refused. TLS to api.wallex.ir
# stays end-to-end and verified inside the tunnel, but the exchange then sees the PROXY's exit IP:
# put that IP in the key's IP allow-list.
WALLEX_PROXY_URL=
# true = use HTTPS_PROXY / HTTP_PROXY (and NO_PROXY) of the PROCESS environment (not of this file)
# when WALLEX_PROXY_URL is empty. false (default) = ignore them.
WALLEX_USE_ENV_PROXY=false
