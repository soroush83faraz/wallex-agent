# /etc/systemd/system/wallex-agent.service
#
# Wallex agent, LIVE mode on a VPS. Paths marked PLACEHOLDER must match your install.
# Read README_FA.md, docs/VPS_SYSTEMD_FA.md and docs/RUNBOOK_LIVE_FA.md before using it.
#
# Install (as root):
#   useradd --system --home /var/lib/wallex-agent --shell /usr/sbin/nologin wallex-agent
#   install -d -m 0750 -o root -g wallex-agent /etc/wallex-agent
#   install -m 0640 -o root -g wallex-agent .env /etc/wallex-agent/wallex-agent.env
#       (WALLEX_API_KEY, TRADING_MODE=live, ENABLE_LIVE=true, INITIAL_TMN, and
#        DATA_DIR=/var/lib/wallex-agent/state. Key WITHOUT withdrawal permission,
#        IP allow-listed to this VPS)
#   shred -u .env     (do not leave a second readable copy of the key; at least chmod 600 it)
#   systemctl daemon-reload && systemctl enable wallex-agent
#
# Every operator command runs as the service user WITH THE SAME ENV FILE as this unit:
#   sudo -u wallex-agent /opt/wallex-agent/.venv/bin/wallex-agent \
#        --env-file /etc/wallex-agent/wallex-agent.env <command>
#
# FIRST START IS OPERATOR-INTERACTIVE, NEVER SYSTEMD: `selftest`, `check-live`, `canary`, then
# `live --i-understand-real-money` (or `live --stage convert ...`) at a terminal, typing the
# confirmation phrase. That run starts the competition clock. `live --resume` (this unit) only
# CONTINUES a competition already started in /var/lib/wallex-agent/state/live/state.db; on a store
# without a started competition it refuses (exit 3) and the unit stays down.
#
# ARMING: this unit only starts after the operator ran `arm-live` (interactive, typed phrase). It
# writes /var/lib/wallex-agent/state/LIVE_ARMED, a record bound to the phrase, this source tree, the
# base URL, DATA_DIR and an expiry (COMPETITION_HOURS + 24 h). Without it, `systemctl start` and
# boot-time starts are silently skipped (ConditionPathExists). Delete the file to disarm. A KILL file
# in the state dir also stops systemd from (re)starting the service, and the bot checks it before
# every order.
#
# PROTECTION MODEL: the gates stop accidents and automated misuse; they do not stop a deliberate
# attacker running as wallex-agent or root (such a process can read the key and forge evidence).
# Recommended on Linux, after arming: make the evidence readable but NOT writable by the service user
# (the directory must be owned by root for the sticky bit to protect root-owned files):
#   cd /var/lib/wallex-agent/state
#   chown root:wallex-agent . selftest.json live_schema_attestation.json live_canary.json LIVE_ARMED
#   chmod 0444 selftest.json live_schema_attestation.json live_canary.json LIVE_ARMED
#   chmod 1770 .
# Remove the sealed files as root before re-running those steps (details: docs/VPS_SYSTEMD_FA.md).
#
# EMERGENCY STOP: `sudo systemctl stop wallex-agent` (cancels resting orders, never sells), then
# `kill` with the env file above so nothing restarts it. After a live agent acted on KILL its ledger
# is STOPPED: delete KILL, check the account, then run `unstop --i-understand-real-money`.
#
# WHY A RESTART IS SAFE (Restart=on-failure):
#   * persist-before-send: each order intent is committed to SQLite (INTENT -> SENDING, with
#     a balance snapshot) BEFORE the single POST, and a client_id is never POSTed twice.
#   * on start, `live --resume` runs ExecutionEngine.reconcile_startup(): it resolves every
#     unresolved/unknown-outcome order from exchange facts (order lookups, open orders, trades,
#     balance delta), re-checks every ABANDONED order on the permanent watch list, rebuilds the
#     ledger from recorded fills, compares it with the real balances and goes STOPPED (no trading)
#     on unexplained drift.
#   * the audit log resumes its hash chain, and the competition start time is persisted,
#     so a restart neither duplicates orders nor resets the 24 h window.
#   The resume path still re-checks the live gates (fresh selftest/attestation for THIS
#   source tree, valid arming record, no KILL file). If a gate fails, the service exits and stays
#   down (RestartPreventExitStatus). It never trades on a failed gate.

[Unit]
Description=Wallex agent (BTC/USDT spot, LIVE under strict gates)
After=network-online.target time-sync.target
Wants=network-online.target
ConditionPathExists=/var/lib/wallex-agent/state/LIVE_ARMED
ConditionPathExists=!/var/lib/wallex-agent/state/KILL
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=wallex-agent
Group=wallex-agent
# PLACEHOLDER install dir and virtualenv
WorkingDirectory=/opt/wallex-agent
EnvironmentFile=/etc/wallex-agent/wallex-agent.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# `--env-file` is explicit so a stray /opt/wallex-agent/.env can never be merged in.
# `--resume` never prompts (no TTY here): it takes the confirmation from the operator-created
# LIVE_ARMED record (`wallex-agent arm-live`), then runs reconcile_startup.
ExecStart=/opt/wallex-agent/.venv/bin/wallex-agent --env-file /etc/wallex-agent/wallex-agent.env live --resume --i-understand-real-money
Restart=on-failure
RestartSec=30
# Exit codes only an operator can fix are never retried (see `wallex-agent --help`):
# 3 live gate refused, 4 kill switch, 5 safety stop (STOPPED), 6 refused precondition.
# 130 = stopped by SIGINT/SIGTERM (graceful, resumable): a clean stop, not a failure.
RestartPreventExitStatus=3 4 5 6
SuccessExitStatus=130
KillSignal=SIGINT
TimeoutStopSec=60
KillMode=mixed

# ---- state: the only writable place
StateDirectory=wallex-agent
StateDirectoryMode=0750
ReadWritePaths=/var/lib/wallex-agent
UMask=0077

# ---- hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# CPython without a JIT does not need writable+executable memory
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
# no core dumps: a dump of this process would contain the API key
LimitCORE=0

[Install]
WantedBy=multi-user.target
